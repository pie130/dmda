# Step 1: Independent variables
Experience <- c(1, 2, 3, 4, 5, 6)
Education <- c(12, 12, 15, 15, 16, 18)

# Step 2: Dependent variable
Salary <- c(25000, 28000, 35000, 42000, 50000, 60000)

# Step 3: Create data frame
employee <- data.frame(Experience, Education, Salary)

# Step 4: Display dataset
print(employee)

# Step 5: Build Multiple Regression Model
model <- lm(Salary ~ Experience + Education, data = employee)

# Step 6: Display summary
summary(model)

# Step 7: Display coefficients
coef(model)

# Step 8: Display predicted salary
predict(model)

# Step 9: Draw scatter plot
plot(
  employee$Experience,
  employee$Salary,
  main = "Experience vs Salary",
  xlab = "Experience (Years)",
  ylab = "Salary",
  pch = 19,
  col = "blue"
)

# Draw regression line
abline(lm(Salary ~ Experience, data = employee),
       col = "red",
       lwd = 2)



# Poisson Regression

# Step 1: Create data
hours <- c(1, 2, 3, 4, 5, 6, 7, 8)
question <- c(2, 3, 4, 5, 8, 10, 13, 16)

data <- data.frame(hours, question)
print(data)

# Step 2: Fit Poisson Regression Model
model <- glm(question ~ hours,
             family = poisson,
             data = data)

# Step 3: Display model
summary(model)

# Step 4: Predict
predicted <- predict(model, type = "response")
print(predicted)

# Step 5: Plot actual observations
plot(data$hours, data$question,
     pch = 19,
     xlab = "Study Hours",
     ylab = "Question Answered",
     main = "Poisson Regression")

# Step 6: Add regression curve
lines(data$hours, predicted, lwd = 2)






# 1. Create dataset

students <- data.frame(
  studyHours = c(2, 3, 4, 5, 6, 7, 8),
  pay = c(0, 0, 0, 1, 1, 1, 1)
)

# 2. Build logistic regression model

model <- glm(
  pay ~ studyHours,
  data = students,
  family = binomial
)

# 3. Display model results

summary(model)

# 4. Calculate probability

students$probability <- predict(
  model,
  type = "response"
)

# 5. Convert probability into class

students$prediction <- ifelse(
  students$probability >= 0.5,
  1,
  0
)

# 6. Display results

print(students)

# 7. Plot actual observations

plot(
  students$studyHours,
  students$pay,
  pch = 19,
  xlab = "Study Hours",
  ylab = "Probability of Passing",
  main = "Logistic Regression"
)

# 8. Draw logistic curve

x <- seq(2, 8, length.out = 100)

y <- predict(
  model,
  newdata = data.frame(studyHours = x),
  type = "response"
)

lines(x, y, lwd = 2, col = "blue")

# 9. Predict for a new student

new_student <- data.frame(studyHours = 5)

prob <- predict(
  model,
  newdata = new_student,
  type = "response"
)

print(prob)

# 10. Final classification

ifelse(prob >= 0.5, "Pass", "Fail")
