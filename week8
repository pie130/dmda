# 1. MEAN
x <- c(12, 7, 10, 4, 3, 5, -20, 2, -5)
result <- mean(x)
print(result)


# 2. TRIMMED MEAN
x <- c(12, 7, 10, 4, 3, 5, -20, 2, -5)
result <- mean(x, trim = 0.2)
print(result)


# 3. MEAN WITH NA VALUES
x <- c(12, 7, 10, 4, 3, 5, -20, 2, -5, NA)
result <- mean(x, na.rm = TRUE)
print(result)


# 4. MEDIAN
z <- c(2, 4, 5, 7, 10, 11, 20, 23)
result1 <- median(z)
print(result1)


# 5. MODE
v <- c(2, 1, 3, 4, 5, 2, 3, 2, 2)
v1 <- c("it", "cc", "cc", "cc", "se")

getmode <- function(v) {
  uniq <- unique(v)
  uniq[which.max(tabulate(match(v, uniq)))]
}

resultm1 <- getmode(v)
print(resultm1)

resultm2 <- getmode(v1)
print(resultm2)


# 6. COVARIANCE
x <- c(5, 7, 3, 6, 8)
y <- c(65, 80, 50, 70, 90)

covariance <- cov(x, y)
print(covariance)


# 7. LINEAR REGRESSION
x <- c(5, 7, 3, 6, 8)
y <- c(65, 80, 50, 70, 90)

reg <- lm(y ~ x)
print(reg)
