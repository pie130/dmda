#Normal Distribution
#DNORM
x<-seq(20,80,by=1)
y<-dnorm(x,mean=50,sd=10)
png(file='dnorm.png')
plot(x,y,
     type="p",
     pch=19,
     col="blue",
     main="Normal Density(dnorm)",
     xlab="Marks",
     ylab="Density"
)
model<-lm(y~x)
abline(model,col="red",lwd=2)
summary(model)
dev.off()
